{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "VaultUri": "https://kv-circlo.vault.azure.net/"
  },
  "Jwt": {
    "Issuer": "Circlo",
    "Audience": "CircloUsers",
    "ExpiryMinutes": 60
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "DisplayName": "Circlo",
    "Email": "circlomyapp@gmail.com"
  },
  "RedisSettings": {
    "DefaultExpiryMinutes": 5
  },
  "Gemini": {
    "ModelId": "gemini-3.6-flash"
  },
  "AzureAI": {
    "Endpoint": "https://circlo-ai.services.ai.azure.com/openai/v1/",
    "DeploymentName": "gpt-5-mini",
    "SemanticKernelEndpoint": "https://circlo-ai.openai.azure.com/"
  },
  "ApplicationInsights": {}
}